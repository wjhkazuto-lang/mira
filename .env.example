# 复制本文件为 .env，然后填写下面的配置。.env 不会被提交到 git。

# 必填：DeepSeek API key（https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=

# DeepSeek 接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 和你聊天用的模型
CHAT_MODEL=deepseek-v4-pro
# 后台提取记忆用的模型
BACKGROUND_MODEL=deepseek-flash
# 每日反思用的模型
REFLECT_MODEL=deepseek-v4-pro
# 聊天的"温度"：越高说话越活泼随性，越低越稳重（DeepSeek 推荐日常对话用 1.3）
CHAT_TEMPERATURE=1.3

# 你最后一条消息发出后，等几秒再回复（期间继续发消息会重新计时）
DEBOUNCE_SECONDS=3
# 从你第一条消息算起最多等几秒
MAX_WAIT_SECONDS=60
# 停止聊天多少分钟后，开始整理记忆
IDLE_WRITE_MINUTES=10
# 每天几点做反思（24 小时制）
REFLECT_HOUR=4
# 每次带上的最近聊天记录长度（约等于字数）
RECENT_HISTORY_TOKENS=4000
# 每次检索的记忆条数
RETRIEVE_TOP_K=8

# 危机求助资源，请按你所在地区修改
CRISIS_RESOURCES=全国心理援助热线 12356；希望24热线 400-161-9995；紧急情况 120/110

# 数据库位置（你的聊天和记忆都在这里，备份它就行）
DB_PATH=data/mira.db
# 人设文件。留空时：如果有 persona.local.md 就用它（不会被 git 提交），否则用 persona.md
PERSONA_PATH=

# 设为 1 进入开发模式：使用假回复，不需要 API key
MIRA_FAKE=
